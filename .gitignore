# IDEA files
/.idea/
/out/
/*.iml

# Compiled Java bytecode (e.g. when compiling with javac outside the IDE)
*.class

# Gradle build files
/.gradle/
/build/
src/main/resources/docs/

# MacOS custom attributes files created by Finder
.DS_Store
*.iml
bin/

# Temp files
_temp/

/text-ui-test/ACTUAL.TXT
text-ui-test/EXPECTED-UNIX.TXT

# Saved tally (user data, not revision-controlled)
/data/

# Python leaves these beside the test runner when it is imported.
__pycache__/
*.pyc
